includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
    
    # Level 0 adalah level terendah (paling toleran)
    level: 0
    
    # KUNCI PERBAIKAN: Jangan gagalkan build jika ada ignore yang tidak terpakai
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Perbaikan Regex: Menghapus tanda kurung \(\) agar cocok dengan pesan error
        - '#Called .env. outside of the config directory#'
        
        # Alternatif: Menggunakan identifier (lebih aman dan spesifik)
        - identifier: larastan.noEnvCallsOutsideOfConfig

        # Mengabaikan error relasi (untuk jaga-jaga)
        - '#Relation .* is not found in .* model#'
        - '#Access to an undefined property .*#'